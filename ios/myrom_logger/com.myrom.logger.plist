<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.myrom.logger</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/myromctl</string>
    <string>append</string>
    <string>/var/log/myrom/myrom.jsonl</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/var/log/myrom/logger.stdout</string>
  <key>StandardErrorPath</key>
  <string>/var/log/myrom/logger.stderr</string>
</dict>
</plist>

